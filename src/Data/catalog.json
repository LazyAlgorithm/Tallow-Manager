{
  "version": 1,
  "items": [
    {
      "id": "tallow",
      "kind": "engine",
      "name": "Tallow",
      "beta": true,
      "summary": "Tallow engine and editor, installed side by side with project versions pinned.",
      "repo": "LazyAlgorithm/Tallow",
      "tagPrefix": "v",
      "assets": {
        "windows": "Tallow-Windows.zip",
        "linux": "Tallow-Linux.zip"
      },
      "run": {
        "windows": "Tallow-Windows/Tallow.exe",
        "linux": "Tallow-Linux/Tallow"
      },
      "requires": [
        "beef",
        "python",
        "microsoft-libraries",
        "linux-build-tools",
        "vc-runtime"
      ],
      "banner": "",
      "icon": "",
      "accent": "#4cc3f0"
    }
  ],
  "dependencies": [
    {
      "id": "beef",
      "name": "Beef compiler",
      "summary": "Compiles Tallow projects' scripts.",
      "size": "about 100 MB",
      "found": [
        {
          "command": {
            "linux": "sh -c 'for exe in \"$(command -v BeefBuild 2>/dev/null)\" \"$(command -v BeefBuild.sh 2>/dev/null)\" \"$HOME/Beef/IDE/dist/BeefBuild.sh\" \"$HOME/beef/IDE/dist/BeefBuild.sh\" \"$HOME/dev/Beef/IDE/dist/BeefBuild.sh\" \"$HOME/dev/beef/IDE/dist/BeefBuild.sh\" /opt/beef/IDE/dist/BeefBuild.sh /opt/Beef/IDE/dist/BeefBuild.sh; do if [ -n \"$exe\" ] && [ -f \"$exe\" ] && [ -x \"$exe\" ]; then exit 0; fi; done; exit 1'"
          }
        },
        {
          "all": [
            {
              "file": {
                "windows": "{tools}/beef/bin/BeefBuild.exe",
                "linux": "{tools}/beef/IDE/dist/BeefBuild.sh"
              }
            },
            {
              "file": {
                "windows": "{tools}/beef/BeefLibs/corlib/BeefProj.toml",
                "linux": "{tools}/beef/BeefLibs/corlib/BeefProj.toml"
              }
            }
          ]
        }
      ],
      "install": {
        "windows": [
          {
            "download": "https://github.com/LazyAlgorithm/Tallow/releases/download/v0.1.0-beta/beef-windows-x64.zip",
            "unpack": "{tools}"
          },
          {
            "write": "{tools}/beef/bin/BeefConfig.toml",
            "text": "Version = 1\nUnversionedLibDirs = [\"../BeefLibs\"]\n"
          }
        ],
        "linux": [
          {
            "download": "https://github.com/LazyAlgorithm/Tallow/releases/download/v0.1.0-beta/beef-linux-x64.tar.gz",
            "unpack": "{tools}"
          }
        ]
      }
    },
    {
      "id": "python",
      "name": "Python 3.11 or later",
      "summary": "Runs Tallow's build scripts. A copy only Tallow uses is installed.",
      "size": "about 50 MB",
      "found": [
        {
          "command": {
            "linux": "sh -c 'for exe in python3 python3.14 python3.13 python3.12 python3.11; do if command -v \"$exe\" >/dev/null 2>&1 && \"$exe\" -c \"import sys; sys.exit(0 if sys.version_info >= (3,11) else 1)\"; then exit 0; fi; done; exit 1'"
          }
        },
        {
          "command": {
            "windows": "python -c \"import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)\"",
            "linux": "python3 -c \"import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)\""
          }
        },
        {
          "file": {
            "windows": "{tools}/python/python.exe",
            "linux": "{tools}/python/bin/python3"
          }
        }
      ],
      "install": {
        "windows": [
          {
            "download": "https://github.com/LazyAlgorithm/Tallow/releases/download/v0.1.0-beta/python-windows-x64.zip",
            "unpack": "{tools}"
          }
        ],
        "linux": [
          {
            "download": "https://github.com/LazyAlgorithm/Tallow/releases/download/v0.1.0-beta/python-linux-x64.tar.gz",
            "unpack": "{tools}"
          }
        ]
      }
    },
    {
      "id": "vc-runtime",
      "name": "Microsoft Visual C++ x64 runtime",
      "summary": "Installs the shared runtime into Windows so other applications can use it. Administrator approval is required.",
      "size": "About 25 MB",
      "platforms": [
        "windows"
      ],
      "licence": {
        "name": "Microsoft Visual C++ Runtime licence",
        "url": "https://learn.microsoft.com/en-us/cpp/windows/redistributing-visual-cpp-files"
      },
      "found": [
        {
          "command": {
            "windows": "powershell -NoProfile -NonInteractive -Command \"$paths = @('HKLM:\\SOFTWARE\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\x64', 'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\x64'); foreach ($p in $paths) { $r = Get-ItemProperty -LiteralPath $p -ErrorAction SilentlyContinue; if ($r.Installed -eq 1) { exit 0 } }; exit 1\""
          }
        },
        {
          "all": [
            {
              "file": {
                "windows": "{windows}/System32/vcruntime140.dll"
              }
            },
            {
              "file": {
                "windows": "{windows}/System32/vcruntime140_1.dll"
              }
            },
            {
              "file": {
                "windows": "{windows}/System32/msvcp140.dll"
              }
            }
          ]
        }
      ],
      "install": {
        "windows": [
          {
            "download": "https://aka.ms/vc14/vc_redist.x64.exe"
          },
          {
            "runAsAdmin": "\"{hub}/downloads/vc_redist.x64.exe\" /install /quiet /norestart /log \"{hub}/vc-runtime-install.log\""
          },
          {
            "delete": "{hub}/downloads/vc_redist.x64.exe"
          }
        ]
      }
    },
    {
      "id": "microsoft-libraries",
      "name": "Microsoft C++ Build Tools and Windows SDK",
      "summary": "Registered Windows installations, usable by Tallow and other apps. Windows asks for administrator approval; setup runs quietly.",
      "size": "Several GB; existing installations are reused",
      "platforms": [
        "windows"
      ],
      "licence": {
        "name": "Microsoft Visual Studio Build Tools licence",
        "url": "https://go.microsoft.com/fwlink/?LinkId=2086102"
      },
      "found": [
        {
          "all": [
            {
              "file": {
                "windows": "{tools}/beef/bin/BeefBuild.exe"
              }
            },
            {
              "beefLibraries": {
                "windows": "{tools}/beef/bin/BeefSettings.toml"
              }
            }
          ]
        }
      ],
      "install": {
        "windows": [
          {
            "download": "https://aka.ms/vs/17/release/vs_BuildTools.exe"
          },
          {
            "write": "{hub}/installer-logs/README.txt",
            "text": "Microsoft installer logs are stored in this folder.\n"
          },
          {
            "runAsAdmin": "\"{hub}/downloads/vs_BuildTools.exe\" --passive --wait --norestart --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended"
          },
          {
            "configureMicrosoft": "{tools}/beef/bin/BeefSettings.toml"
          },
          {
            "delete": "{hub}/downloads/vs_BuildTools.exe"
          }
        ]
      },
      "alsoInstall": [
        "beef",
        "vc-runtime"
      ]
    },
    {
      "id": "linux-build-tools",
      "name": "C compiler, X11 and OpenGL development files",
      "summary": "What Linux programs are linked with. Installed by your system's package manager, which asks for your password.",
      "platforms": [
        "linux"
      ],
      "found": [
        {
          "all": [
            {
              "program": "cc"
            },
            {
              "libraries": [
                "libGL.so",
                "libX11.so"
              ]
            }
          ]
        }
      ],
      "install": {
        "linux": [
          {
            "packages": {
              "apt-get": "build-essential libgl-dev libx11-dev",
              "dnf": "gcc gcc-c++ mesa-libGL-devel libX11-devel",
              "pacman": "base-devel libglvnd libx11",
              "zypper": "gcc gcc-c++ Mesa-libGL-devel libX11-devel"
            }
          }
        ]
      }
    }
  ]
}
